# Comoot Backend — lokale Konfiguration fuer den Betrieb OHNE Docker
# (uvicorn direkt auf dem Host, DB/BRouter aus docker-compose).
# Kopieren nach `.env`; docker compose liest daraus NUR `DB_HOST_PORT`.

# PostgreSQL/PostGIS-Verbindung vom Host aus (asyncpg DSN).
# Port = DB_HOST_PORT aus docker-compose.yml (Standard 5433, nicht 5432).
DATABASE_URL=postgresql://comoot:comoot@localhost:5433/comoot

# Host-Port der Docker-PostGIS (Container-intern bleibt immer 5432).
# Standard 5433, damit ein lokal laufendes Postgres auf 5432 nicht kollidiert.
DB_HOST_PORT=5433

# BRouter RouteServer vom Host aus (Basis-URL, Port 17777).
# In den Containern setzt docker-compose.yml stattdessen http://brouter:17777
# und postgresql://comoot:comoot@db:5432/comoot fest.
BROUTER_URL=http://localhost:17777

# Erlaubte CORS-Origins (kommagetrennt; * = alle)
CORS_ORIGINS=*
