# Comoot Backend — lokale Konfiguration (Betrieb OHNE Docker)
# Kopieren nach `.env` und Werte anpassen.

# PostgreSQL/PostGIS-Verbindung (asyncpg DSN)
DATABASE_URL=postgresql://comoot:comoot@localhost:5432/comoot

# BRouter RouteServer (Basis-URL, Port 17777)
BROUTER_URL=http://localhost:17777

# Erlaubte CORS-Origins (kommagetrennt; * = alle)
CORS_ORIGINS=*
